<Window x:Class="PlumbingSolution.FireProtection.UI.ProcessBarForm.FrmProcessbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PlumbingSolution.FireProtection.UI.ProcessBarForm"
             mc:Ignorable="d" Title="Processing..."
             Height="145" Width="500"
             WindowStartupLocation="CenterScreen"
             ResizeMode="NoResize"
             Loaded="Window_Loaded"
             SourceInitialized="Window_SourceInitialized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ProgressBar x:Name="prgSingle" Grid.Row="0"
                     x:FieldModifier="public" Margin="0 10 0 0">
            <ProgressBar.Foreground>
                <SolidColorBrush Color="#FFBBE2FC" />
            </ProgressBar.Foreground>
        </ProgressBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="tbxFinish" x:FieldModifier="public"
                       Height="18" TextWrapping="Wrap" Margin="10"
                       VerticalAlignment="Center" Text="Hoàn thành" />

            <TextBlock Grid.Column="1" x:Name="tbxMessage" x:FieldModifier="public"
                       Height="18" VerticalAlignment="Center"><Run Text="" />
                <InlineUIContainer>
                </InlineUIContainer>
            </TextBlock>
        </Grid>

        <Button x:Name="btnCancel" Grid.Row="2" Content="Kết thúc" Width="80"  Height="25"
                Click="btnCancel_Click"
                HorizontalAlignment="Right" Margin="5"
                IsCancel="True">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5" />
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>